# EasyKit: EasyEngine's ground, talking and checkpoints, written as mechanisms. Its simple level behaviors (doors, zones,
# pickups, switches, gates, springs) are shipped behavior packages instead (Packages/*.behavior, "replaces").
# EasyEngine names objects, not tags: 'trigger', 'target', 'collector'… are object names ("Player"), found with
# easy_find. "Touching" is EasyEngine's: overlapping, or resting against it when this object is solid (easy_contact).

mechanism EasySolid
    # Solid (ground / platform): bodies stand on it; one-way = jump up through it, land on top.
    param one_way: yesno = false

    when start
        if one_way
            oneway
        else
            solid

mechanism EasyInteract
    # Interact (press a key): when the trigger is near and presses the key — say, set or add to a variable, go to a scene.
    # One key press uses one Interact of an object (two with opposite "only while" make an on/off toggle).
    param action: text = "say"
    param text: text = "Hello!"
    param speaker: text = ""
    param var: text = ""
    param set_to: number = 1
    param amount: number = 1
    param scene: text = ""
    param key: text = "e"
    param trigger: text = "Player"
    param radius: number = 60
    param once: yesno = false
    param freeze: yesno = false
    param cond: text = ""

    when tick
        down = easy_key(key)
        if not down: easy_unlatch key
        if not easy_on(cond): stop
        who = easy_find(trigger)
        if not who: stop
        active = distance(self, who) <= radius and down
        fire = active and not was and not easy_talking()
        was = active
        if not fire or (once and fired): stop
        if not easy_latch(key): stop
        fired = true
        easy_interacted
        if action == "say"
            easy_say text, speaker, freeze
        else if action == "setvar"
            easy_set var, set_to
        else if action == "addvar"
            easy_add var, amount
        else if action == "goscene"
            easy_goto scene

mechanism EasyCheckpoint
    # Checkpoint: when the target touches it, it comes back here (standing on its bottom, centred) after dying.
    param target: text = "Player"

    when tick
        who = easy_find(target)
        if who and easy_contact(self, who)
            tell who "easy checkpoint" [self.x + self.width / 2 - who.width / 2, self.y + self.height - who.height]
