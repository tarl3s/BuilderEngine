# EasyKit: EasyEngine's movement behaviors, written as mechanisms so an EasyEngine project plays in BuilderEngine.
# EasyCompat (EasyCompat.cs) gives each EasyEngine behavior its mechanism here, with the behavior's settings as params,
# when the game starts: the project itself keeps EasyEngine's data. EasyEngine's numbers: gravity 2000 px/s², a body
# falls at most 1500 px/s, and a jump is a speed (640 = about 100 px high).
# 'cond' is the behavior's "Only while" formula (EasyEngine's own formula language, read by easy_on).

mechanism EasyPlatformer
    # Platformer Character: run, jump (let go early for a small hop), coyote time, jump buffer, double jump, wall jump, dash.
    param controls: yesno = true
    param speed: number = 260
    param jump: number = 640
    param double_jump: yesno = false
    param wall_jump: yesno = false
    param dash: yesno = false
    param dash_speed: number = 560
    param dash_key: text = "leftshift"
    param left_key: text = ""
    param right_key: text = ""
    param jump_key: text = ""
    param collide: yesno = true
    param gravity: number = 2000
    param driven: yesno = false
    param fall_dies: yesno = true
    param cond: text = ""

    when start
        scale = 1
        facing = 1
        if collide: body gravity, 1500

    when tick
        if fall_dies and easy_fell(): destroy self
        if not easy_on(cond)
            if not driven and not easy_knocked(): self.vx = 0
            held = false
            stop
        h = 0
        if controls
            if key("left") or key("a"): h -= 1
            if key("right") or key("d"): h += 1
        if right_key != "" and easy_key(right_key): h += 1
        if left_key != "" and easy_key(left_key): h -= 1
        h = clamp(h, -1, 1)
        jump_down = controls and (key("space") or key("up") or key("w"))
        if jump_key != "" and easy_key(jump_key): jump_down = true
        if self.on_ground
            coyote = 0.1
            jumps_left = 0
            if double_jump: jumps_left = 1
            dash_left = 1
        else
            coyote -= dt
        if jump_down and not held
            buffer = 0.12
        else
            buffer -= dt
        if dash_time > 0
            dash_time -= dt
            self.vx = dash_vx
            self.vy = dash_vy - gravity * dt
            held = jump_down
            dash_was = dash and easy_key(dash_key)
            stop
        if not easy_knocked() and (h != 0 or not driven): self.vx = h * speed * scale
        wall = 0
        if wall_jump and not self.on_ground
            if easy_solid_beside(1)
                wall = 1
            else if easy_solid_beside(-1)
                wall = -1
            if wall != 0 and self.vy > 0: self.vy = min(self.vy, 120)
        if buffer > 0
            if coyote > 0 or self.on_ground
                self.vy = -jump
                buffer = 0
                coyote = 0
            else if wall != 0
                self.vy = -jump
                self.vx = -wall * speed * scale * 1.1
                buffer = 0
            else if double_jump and jumps_left > 0
                self.vy = -jump
                jumps_left -= 1
                buffer = 0
        if held and not jump_down and self.vy < 0: self.vy *= 0.45
        dash_held = dash and easy_key(dash_key)
        if dash_held and not dash_was and dash_left > 0
            dx = h
            dy = 0
            if key("up") or key("w"): dy -= 1
            if key("down") or key("s"): dy += 1
            if dx == 0 and dy == 0: dx = facing
            size = sqrt(dx * dx + dy * dy)
            dash_vx = dx / size * dash_speed
            dash_vy = dy / size * dash_speed
            dash_time = 0.15
            dash_left -= 1
        held = jump_down
        dash_was = dash_held
        if h != 0
            facing = h
        else if self.vx > 1
            facing = 1
        else if self.vx < -1
            facing = -1
        if facing < 0
            face left
        else
            face right

mechanism EasyTopDown
    # Top-Down Movement: eight directions, no gravity, stopped by walls.
    param controls: yesno = true
    param speed: number = 220
    param collide: yesno = true
    param up_key: text = ""
    param down_key: text = ""
    param left_key: text = ""
    param right_key: text = ""
    param driven: yesno = false
    param cond: text = ""

    when start
        scale = 1
        if collide: body 0, 0

    when tick
        if not easy_on(cond)
            if not driven and not easy_knocked()
                self.vx = 0
                self.vy = 0
            stop
        hx = 0
        hy = 0
        if controls
            if key("left") or key("a"): hx -= 1
            if key("right") or key("d"): hx += 1
            if key("up") or key("w"): hy -= 1
            if key("down") or key("s"): hy += 1
        if right_key != "" and easy_key(right_key): hx += 1
        if left_key != "" and easy_key(left_key): hx -= 1
        if down_key != "" and easy_key(down_key): hy += 1
        if up_key != "" and easy_key(up_key): hy -= 1
        sp = speed * scale
        if not easy_knocked() and (hx != 0 or hy != 0 or not driven)
            self.vx = clamp(hx, -1, 1) * sp
            self.vy = clamp(hy, -1, 1) * sp
        if hx < 0: face left
        if hx > 0: face right

mechanism EasyBody
    # Physics "Dynamic": it falls with EasyEngine's gravity and stands on solid things.
    param gravity: number = 2000
    param fall_dies: yesno = true

    when start
        body gravity, 1500

    when tick
        if fall_dies and easy_fell(): destroy self

mechanism EasyPatrol
    # Patrol: back and forth (or up and down), turning at its ends, at walls and at the scene's edge.
    param speed: number = 90
    param distance: number = 200
    param vertical: yesno = false
    param smooth: yesno = false
    param slow_steps: number = 0
    param pause: number = 0
    param has_chase: yesno = false
    param cond: text = ""

    when start
        scale = 1
        dir = 1
        start_x = self.x
        start_y = self.y
        frame = 0

    when tick
        frame += 1
        if has_chase and self.EasyChase.chasing: stop
        if not easy_on(cond) or easy_knocked()
            if not easy_on(cond)
                self.vx = 0
                if not easy_dynamic(): self.vy = 0
            stop
        spd = speed * scale
        dist = max(1, distance)
        pos = self.x
        start = start_x
        if vertical
            pos = self.y
            start = start_y
        stop_at = start + dist
        blocked = last_frame == frame - 1 and abs(want) * dt > 0.05 and ((want > 0 and dir > 0) or (want < 0 and dir < 0)) and abs(pos - last) < abs(want) * dt * 0.1
        last_frame = frame
        last = pos
        v = 0
        if pause_left > 0
            pause_left -= dt
        else
            at_end = blocked or (dir > 0 and pos >= stop_at) or (dir < 0 and pos <= start)
            if not smooth
                if at_end: dir = -dir
                v = dir * spd
            else if at_end
                if not blocked
                    edge = start
                    if dir > 0: edge = stop_at
                    if vertical
                        self.y = edge
                    else
                        self.x = edge
                dir = -dir
                if pause > 0
                    pause_left = pause
                else
                    v = dir * spd * 0.12
            else
                k = 1
                if slow_steps > 0
                    remaining = start - pos
                    if dir > 0: remaining = stop_at - pos
                    zone = dist * 0.5
                    if remaining < zone
                        level = max(1, -floor(-(max(0, remaining) / zone * slow_steps)))
                        k = clamp(level / slow_steps, 0.12, 1)
                v = dir * spd * k
        if vertical
            self.vy = v
            self.vx = 0
        else
            self.vx = v
            if not easy_dynamic(): self.vy = 0
        want = v

mechanism EasyChase
    # Chase: runs after an object (with gravity it walks on the ground), never overshooting it. 'range' 0 = always.
    param target: text = "Player"
    param speed: number = 140
    param range: number = 0
    param driven: yesno = false
    param cond: text = ""

    when start
        scale = 1
        chasing = false

    when tick
        t = easy_find(target)
        chasing = t and easy_on(cond) and (range <= 0 or distance(self, t) <= range)
        if easy_knocked(): stop
        if not chasing
            if not driven
                self.vx = 0
                if not easy_dynamic(): self.vy = 0
            stop
        dx = t.x + t.width / 2 - (self.x + self.width / 2)
        dy = t.y + t.height / 2 - (self.y + self.height / 2)
        sp = speed * scale
        if easy_dynamic()
            if abs(dx) <= sp * dt
                self.vx = dx / dt
            else if dx > 0
                self.vx = sp
            else
                self.vx = -sp
        else
            size = sqrt(dx * dx + dy * dy)
            if size <= sp * dt
                self.vx = dx / dt
                self.vy = dy / dt
            else
                self.vx = dx / size * sp
                self.vy = dy / size * sp
        if dx < -1: face left
        if dx > 1: face right

mechanism EasyProjectile
    # Projectile: flies in a direction (degrees, 0 = right, 90 = down) and disappears after 'life' seconds (0 = never).
    param speed: number = 420
    param angle: number = 0
    param life: number = 3

    when start
        if self.vx == 0 and self.vy == 0
            self.vx = cos(angle) * speed
            self.vy = sin(angle) * speed
        if life > 0
            wait life
            destroy self

mechanism EasyStayInside
    # Stay Inside: kept inside the scene (or what the camera shows) after it moves: it stops, bounces or wraps around.
    param area: text = "scene"
    param sides: text = "all"
    param edge: text = "stop"

    when start
        # a forever loop goes one round per frame, after physics — where EasyEngine keeps it inside
        repeat forever
            x0 = 0
            y0 = 0
            x1 = scene_width
            y1 = scene_height
            if area == "screen"
                x0 = camera_x - view_width / 2
                y0 = camera_y - view_height / 2
                x1 = x0 + view_width
                y1 = y0 + view_height
            lr = sides == "all" or sides == "leftright" or sides == "notbottom"
            top = sides == "all" or sides == "topbottom" or sides == "notbottom"
            bottom = sides == "all" or sides == "topbottom"
            if edge == "wrap"
                if lr
                    if self.x > x1
                        self.x = x0 - self.width
                    else if self.x + self.width < x0
                        self.x = x1
                if bottom and self.y > y1
                    self.y = y0 - self.height
                else if top and self.y + self.height < y0
                    self.y = y1
            else
                k = 0
                if edge == "bounce": k = -1
                if lr
                    if self.x < x0
                        self.x = x0
                        if self.vx < 0: self.vx *= k
                    else if self.x + self.width > x1
                        self.x = x1 - self.width
                        if self.vx > 0: self.vx *= k
                if top and self.y < y0
                    self.y = y0
                    if self.vy < 0: self.vy *= k
                else if bottom and self.y + self.height > y1
                    self.y = y1 - self.height
                    if self.vy > 0: self.vy *= k

mechanism EasySpin
    # Spin: turns on its own (degrees per second).
    param speed: number = 90

    when tick
        self.angle += speed * dt

mechanism EasyParallax
    # Parallax: a background that scrolls slower than the camera (0 = far away, 1 = moves with the scene).
    param factor: number = 0.5

    when start
        home_x = self.x
        home_y = self.y
        repeat forever
            k = 1 - clamp(factor, 0, 1)
            self.x = home_x + (camera_x - view_width / 2) * k
            self.y = home_y + (camera_y - view_height / 2) * k
