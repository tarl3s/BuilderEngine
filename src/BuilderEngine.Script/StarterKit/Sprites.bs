# Starter kit: pictures and animation. Pictures live in the project's images folder.
#   look "hero.png"           draws that picture in the object's box
#   animate "walk"            plays the object's own animation "walk" (Animations... in the inspector),
#                             else walk1.png, walk2.png... (or a strip of square frames in walk.png)
#   face left / face right    mirrors the picture

mechanism Sprite
    # Shows a picture instead of the coloured box.
    param picture: Image = ""
    param flip: yesno = false

    when start
        if picture != "": look picture
        if flip: face left

mechanism Animator
    # Picks an animation from how the object moves (works with Platformer, Patrol, Body...).
    # It plays the object's own animations (Animations... in the inspector) or numbered pictures.
    param idle: animation = "idle"
    param walk: animation = "walk"
    param jump: animation = "jump"
    # 0 = each animation's own speed
    param fps: number = 0

    when tick
        if self.vx < 0: face left
        if self.vx > 0: face right
        if not self.on_ground and self.vy != 0 and jump != ""
            animate jump at fps
        else if self.vx != 0 and walk != ""
            animate walk at fps
        else if idle != ""
            animate idle at fps
