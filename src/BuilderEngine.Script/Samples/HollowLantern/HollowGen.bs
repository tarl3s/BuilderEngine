mechanism HollowGen
    # Digs out the Hollow when the game starts: a top-down cavern of dirt and stone with open caves, coal and copper
    # veins, glowing emberite further in, skyglass near the heart, a ring of deepstone around the Warden's hall in
    # the middle, glowcap mushrooms here and there, and a clearing where the player wakes up.
    # Put it on any object (it isn't drawn). The same seed always makes the same cave.
    param columns: number = 80
    param rows: number = 80
    param cell: number = 32
    param seed: number = 7
    param hall: number = 6
    param ring: number = 3
    param glowcaps: number = 30

    when start
        visible = false
        if seed != 0: random_seed seed
        kinds
        make_map columns, rows with cell
        make_map columns, rows with cell as "Floor" behind
        right = columns * cell - 1
        bottom = rows * cell - 1
        fill_tiles "floor" from 0, 0 to right, bottom in "Floor"
        noise_tiles "moss" from "floor" with 0.16, 0.64 in "Floor"
        fill_tiles "dirt" from 0, 0 to right, bottom
        noise_tiles "stone" from "dirt" with 0.07, 0.47
        noise_tiles "none" from "dirt" with 0.11, 0.57
        noise_tiles "none" from "stone" with 0.11, 0.63
        noise_tiles "coal" from "stone" with 0.32, 0.69
        noise_tiles "copper" from "dirt" with 0.3, 0.72
        noise_tiles "copper" from "stone" with 0.3, 0.74
        noise_tiles "emberite" from "stone" with 0.36, 0.84
        heart
        fill_tiles "bedrock" from 0, 0 to right, cell - 1
        fill_tiles "bedrock" from 0, bottom - cell + 1 to right, bottom
        fill_tiles "bedrock" from 0, 0 to cell - 1, bottom
        fill_tiles "bedrock" from right - cell + 1, 0 to right, bottom
        clear_around find("player"), 3
        clear_around find("workbench"), 1
        repeat glowcaps
            place_glowcap
        emit made

    to kinds
        tile_kind "floor" with "#29231F" picture "floor.png" background
        tile_kind "moss" with "#26302A" picture "floor_moss.png" background
        tile_kind "hall floor" with "#2A2233" picture "floor_hall.png" background
        tile_kind "dirt" with "#6B4A32" picture "dirt.png" hardness 0.35 drop "none"
        tile_kind "stone" with "#5E5A57" picture "stone.png" hardness 0.8
        tile_kind "coal" with "#3A3430" picture "coal.png" hardness 0.9
        tile_kind "copper" with "#B8693A" picture "copper.png" hardness 1.2
        tile_kind "emberite" with "#E0782E" picture "emberite.png" hardness 1.8 light 7 drop "ember"
        tile_kind "skyglass" with "#5FC8F0" picture "skyglass.png" hardness 2.4 light 8
        tile_kind "deepstone" with "#3A2E52" picture "deepstone.png" hardness 5 drop "none"
        tile_kind "bedrock" with "#0E0C0B" picture "bedrock.png" unbreakable

    to heart
        # The Warden's hall in the middle, a ring of deepstone around it, and richer ore close to it.
        mid = columns * cell / 2
        reach = hall + ring + 14
        for each r in range(-reach, reach - 1)
            for each c in range(-reach, reach - 1)
                x = mid + (c + 0.5) * cell
                y = mid + (r + 0.5) * cell
                d = sqrt((c + 0.5) * (c + 0.5) + (r + 0.5) * (r + 0.5))
                if d < hall
                    set_tile x, y to "none"
                    set_tile x, y to "hall floor" in "Floor"
                else if d < hall + ring
                    set_tile x, y to "deepstone"
                else if d < hall + ring + 1.2
                    set_tile x, y to "stone"
                else
                    t = tile_at(x, y)
                    if t == "stone" or t == "dirt"
                        if d < hall + ring + 9 and noise(c * 0.45 + 40, r * 0.45) > 0.66
                            set_tile x, y to "skyglass"
                        else if noise(c * 0.4, r * 0.4 + 70) > 0.7
                            set_tile x, y to "emberite"

    to clear_around obj, cells
        if not obj: return
        fill_tiles "none" from obj.x - cells * cell, obj.y - cells * cell to obj.x + obj.width + cells * cell, obj.y + obj.height + cells * cell

    to place_glowcap
        mid = columns * cell / 2
        repeat 40
            x = random(2, columns - 3) * cell + cell / 2
            y = random(2, rows - 3) * cell + cell / 2
            if tile_at(x, y) == "" and distance(x, y, mid, mid) > (hall + 2) * cell
                make Glowcap at x - 8, y - 8 with 16, 16
                return
