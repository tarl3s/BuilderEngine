mechanism Pickaxe
    # Dig and fight with a pickaxe. Hold the left mouse button on a wall within reach, or walk into one, to dig it —
    # what it drops goes into the inventory. Click a creature, or press Space, to swing at everything next to you.
    # Better picks (crafted at the workbench) dig faster, can break deepstone and hit harder.
    param reach: number = 100
    param swing_reach: number = 50
    param cooldown: seconds = 0.35

    when start
        power = 1
        damage = 1
        tier = "Old Pick"
        facing = 0
        next_swing = 0
        next_hint = 0
        next_sound = 0

    when tick
        update_tier
        if abs(self.vx) + abs(self.vy) > 1: facing = angle(0, 0, self.vx, self.vy)
        if mouse_down() and not mouse_over_ui()
            target = enemy_at(mouse_x, mouse_y)
            if target
                if distance(self, target) - target.width / 2 < reach: swing target
            else
                dig_at mouse_x, mouse_y, true
        else
            bump_dig

    when key "space"
        swing false

    to update_tier
        if has("ember pick")
            power = 3.5
            damage = 3
            tier = "Ember Pick"
        else if has("copper pick")
            power = 2
            damage = 2
            tier = "Copper Pick"
        else
            power = 1
            damage = 1
            tier = "Old Pick"

    to enemy_at x, y
        for each e in all("enemy")
            if x >= e.x - 6 and x <= e.x + e.width + 6 and y >= e.y - 6 and y <= e.y + e.height + 6
                return e
        return false

    to swing target
        if time < next_swing: return
        next_swing = time + cooldown
        play "swing.wav"
        a = facing
        if target: a = angle(self, target)
        cx = self.x + self.width / 2
        cy = self.y + self.height / 2
        make Slash at cx + cos(a) * 22 - 14, cy + sin(a) * 22 - 14 with 28, 28
        if cos(a) < 0: made.Slash.flip = true
        for each e in all("enemy")
            if distance(self, e) - e.width / 2 < swing_reach
                tell e "damage" damage

    to bump_dig
        # Pushing against a wall digs it (the cell right in front, the way you walk).
        dx = 0
        dy = 0
        if key("left") or key("a"): dx -= 1
        if key("right") or key("d"): dx += 1
        if key("up") or key("w"): dy -= 1
        if key("down") or key("s"): dy += 1
        cx = self.x + self.width / 2
        cy = self.y + self.height / 2
        if dx != 0 and tile_solid(cx + dx * (self.width / 2 + 4), cy)
            dig_at cx + dx * (self.width / 2 + 4), cy, false
        else if dy != 0 and tile_solid(cx, cy + dy * (self.height / 2 + 4))
            dig_at cx, cy + dy * (self.height / 2 + 4), false

    to dig_at x, y, aimed
        if aimed and distance(self.x + self.width / 2, self.y + self.height / 2, x, y) > reach: return
        kind = tile_at(x, y)
        if kind == "": return
        if kind == "bedrock": return
        if kind == "deepstone" and power < 2
            if time > next_hint
                notify "Deepstone is too hard for the Old Pick. Craft a Copper Pick first."
                next_hint = time + 3
            return
        dig_tile x, y with power
        if broken != ""
            play "break.wav"
            if drop != "": give drop, 1
        else if time > next_sound
            play "dig.wav"
            next_sound = time + 0.22
