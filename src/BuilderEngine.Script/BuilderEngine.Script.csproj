<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BuilderEngine.Script</RootNamespace>
    <!-- CA2255 ([ModuleInitializer] in a library): here on purpose. Feature files register their commands into
         World.Installers (and samples into SampleGames.All) from a module initializer, which the runtime runs once,
         before any type of this assembly is used — so before the first World is made. The installers never set the same
         command or function, so their order doesn't matter (tested: AuditDataTests, "installers don't depend on their order"). -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BuilderEngine.Plugin\BuilderEngine.Plugin.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="StarterKit\*.bs" LogicalName="StarterKit.%(Filename).bs" />
  </ItemGroup>
  <!-- EasyKit (StarterKit/EasyEngine/*.bs): EasyEngine's behaviors written as mechanisms, loaded only into worlds that
       play an EasyEngine project (EasyCompat.cs). Not part of the starter kit: they don't show in the library. -->
  <ItemGroup>
    <EmbeddedResource Include="StarterKit\EasyEngine\*.bs" LogicalName="EasyKit.%(Filename).bs" />
  </ItemGroup>
  <!-- Starter systems (Systems/*.bs): sets of mechanisms that work together (Systems.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="Systems\*.bs" LogicalName="Systems.%(Filename).bs" />
  </ItemGroup>
  <!-- Sample games' mechanisms (Samples/<Game>/*.bs), read back by each sample builder in Samples/*.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="Samples\**\*.bs" LogicalName="Samples.%(RecursiveDir)%(Filename).bs" />
  </ItemGroup>
</Project>
