<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BuilderEngine.Script</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BuilderEngine.Plugin\BuilderEngine.Plugin.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="StarterKit\*.bs" LogicalName="StarterKit.%(Filename).bs" />
  </ItemGroup>
  <!-- Starter systems (Systems/*.bs): sets of mechanisms that work together (Systems.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="Systems\*.bs" LogicalName="Systems.%(Filename).bs" />
  </ItemGroup>
  <!-- Sample games' mechanisms (Samples/<Game>/*.bs), read back by each sample builder in Samples/*.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="Samples\**\*.bs" LogicalName="Samples.%(RecursiveDir)%(Filename).bs" />
  </ItemGroup>
</Project>
