<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.2.0</Version>
    <ApplicationIcon>Assets\BuilderEngine.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!-- The code editor (syntax colours, its own undo, line margins): the standard Avalonia code editor. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BuilderEngine.Script\BuilderEngine.Script.csproj" />
  </ItemGroup>
</Project>
